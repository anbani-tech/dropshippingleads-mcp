# PREPARATION ONLY. Copy to a private production.env and replace the hostname.
# This file is intentionally not runnable: REPLACE_MCP_HOST fails config validation.
# Nothing here configures DNS, certificates, Nginx, or public deployment.
DSL_HTTP_MODE=proxy
DSL_HTTP_PORT=54170
DSL_PUBLIC_ORIGIN=https://REPLACE_MCP_HOST

# Exact HTTPS origins, separated by commas; omit to allow only DSL_PUBLIC_ORIGIN.
# No wildcard, path, trailing slash, credentials, .invalid, or .example values.
# Add a real browser client's origin only after verifying it is needed.
# DSL_ALLOWED_ORIGINS=https://REPLACE_MCP_HOST

# Explicit same-host Nginx peer only; the application still binds 127.0.0.1.
# Do not replace with a public IP, CIDR, wildcard, CDN range or remote proxy.
DSL_TRUSTED_PROXY_IPS=127.0.0.1

# Application limits cover /mcp and /health, including preflight requests.
DSL_RATE_PER_MINUTE=60
DSL_RATE_BURST=10
DSL_RATE_MAX_CONCURRENT_PER_CLIENT=4
DSL_RATE_MAX_CONCURRENT_TOTAL=64
DSL_RATE_MAX_CLIENTS=10000

# Optional: use an operator-controlled absolute path to a reviewed public catalog.
# This is not a database connection and cannot be supplied by MCP callers.
# DSL_PUBLIC_DATASET=/srv/dsl-mcp/data/catalog.json
